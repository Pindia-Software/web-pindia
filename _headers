# Cabeceras de seguridad para Cloudflare (Workers static assets) / Netlify.
# Las redirecciones 301 van en _redirects (este fichero solo admite cabeceras).

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://www.google-analytics.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Link: </llms.txt>; rel="describedby"; type="text/markdown"
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"

# Caché agresivo de assets. CSS/JS/fuentes van versionados con ?v= en el HTML,
# así que un cambio real fuerza una URL nueva → seguro cachear 1 año immutable.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Frames de la animación scroll y vídeos: contenido fijo, nunca cambian in situ.
/assets/videos/*
  Cache-Control: public, max-age=31536000, immutable
# Imágenes e iconos no llevan ?v=: caché largo pero revalidable por si se sustituyen.
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/icons/*
  Cache-Control: public, max-age=2592000
/assets/favicons/*
  Cache-Control: public, max-age=2592000
